# PostgreSQL connection used by lib/db and the API server.
DATABASE_URL=postgresql://username:password@localhost:5432/sakhisetu

# Session signing secret. Generate a long random string for real use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-local-development-secret

# Supplied by the Replit workflow; these are useful for local package scripts.
PORT=5000
BASE_PATH=/

# Set both to create a real (non-public) admin account on first seed.
# Without these, an admin account is only created when DEMO_MODE=true (see below).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# When true, the server auto-seeds demo data on first boot if the database is
# empty, exposes GET /api/auth/demo (demo account list) and creates a
# clearly-labelled demo admin account if ADMIN_EMAIL/ADMIN_PASSWORD are unset.
# Leave unset/false for anything resembling production.
DEMO_MODE=true

# Password used for all seeded demo accounts (only relevant when DEMO_MODE=true
# or when running the seed script). Change it for anything beyond local dev.
DEMO_PASSWORD=SakhiDemo2026

# Optional: enables "AI-assisted learning feedback" on written short-answer
# assessment responses (see artifacts/api-server/src/lib/ai.ts). Safely
# disabled and never fabricated if left unset — matching and Sakhi Score are
# never affected by this key either way.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed origins for CORS + same-origin write checks,
# e.g. https://your-frontend-domain.example. Required in production; in local
# dev the frontend Vite dev server talks to the API directly.
CORS_ORIGIN=

# Set to true in production behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false
